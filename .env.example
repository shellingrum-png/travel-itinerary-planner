# 环境变量示例 —— 复制为 .env 后填入真实值,确保 .env 已被 gitignore
# 所有 Key 均为云服务凭据,严禁提交到 git

# ── 地图(高德) ─────────────────────────────
# 高德 Web 服务 Key(路由/POI/地理编码)
AMAP_WEB_KEY=your_amap_web_key
# 高德 JS/小程序 Key + 安全密钥(前端渲染用,可放到前端 .env)
AMAP_JS_KEY=your_amap_js_key
AMAP_JS_SECRET=your_amap_js_secret

# ── AI 景点卡片(DeepSeek / 硅基流动 二选一) ─────
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your_llm_api_key
LLM_MODEL=deepseek-chat
# 硅基流动示例(若走 siliconflow):
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# ── (可选)云同步 ───────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── App ──────────────────────────────────
APP_DEFAULT_CURRENCY=CNY
ROUTE_CACHE_TTL_DAYS=30
POI_SEARCH_CACHE_TTL_DAYS=7