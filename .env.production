# ── 生产环境(公网构建用) ───────────────────────
# 本文件不含密钥,可提交。Vite prod 构建加载顺序:.env.production 高于 .env。
# 源站类变量(SYNC/TRANSPORT)留空 = 同源,代码会补 /api 前缀;
# 密钥类变量留空以覆盖 .env 里的开发 key,防止打进 bundle。

# ── 云同步 / 交通(同源后端,Nginx 反代 /api → Node 8766) ──
# 留空 = 同源(相对 /api),代码会补 /api 前缀。填 = 指定源站(如 http://host:8766)
VITE_TRANSPORT_API=
VITE_SYNC_API=

# ── AI 卡片:走后端代理,key 在 server/.env ──
VITE_LLM_BASE_URL=/api/llm
VITE_LLM_PROXY=1
VITE_LLM_API_KEY=
VITE_LLM_MODEL=deepseek-v4-flash

# ── 高德 Web 服务 key:走后端代理,空值覆盖 .env 防止 Web key 进 bundle ──
VITE_AMAP_PROXY=proxy
VITE_AMAP_WEB_KEY=

# ── 多用户登录(自建后端 Auth,见 server/index.js /api/auth/*) ──
# 不再依赖 Supabase;账号与云同步数据都存后端本地文件(server/data/)。
# 后端 JWT 密钥在 server/.env 的 JWT_SECRET 配置(未配置则自动生成并持久化)。

# ── App ──
VITE_APP_DEFAULT_CURRENCY=CNY
VITE_ROUTE_CACHE_TTL_DAYS=30
VITE_POI_SEARCH_CACHE_TTL_DAYS=7
